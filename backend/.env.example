# Copy to .env for optional local defaults. Explicit process variables take precedence.
HTTP_PORT=8080
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5433/chat_app?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5433/chat_app_test?sslmode=disable

# Replace with a randomly generated secret (at least 32 bytes).
# The API and seed commands load .env from their current working directory.
JWT_SECRET=
JWT_ISSUER=chat-app
JWT_AUDIENCE=chat-app-mobile
JWT_TTL=24h

# Optional: only cmd/seed reads these. Existing accounts are never overwritten.
SEED_A_NAME=Demo A
SEED_A_EMAIL=demo-a@example.test
SEED_A_PASSWORD=
SEED_B_NAME=Demo B
SEED_B_EMAIL=demo-b@example.test
SEED_B_PASSWORD=

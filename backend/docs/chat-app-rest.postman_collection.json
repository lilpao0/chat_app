        {
          "name": "02 Upload file directly to GCS",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{mediaUploadUrl}}"
            },
            "description": "single-chunk upload. Select matching local file. No backend JWT. HTTP stack sets Content-Length; GCS final 200/201 then complete. For chunk recovery follow CONTRACTS 9.2, not redirect semantics for 308. Set mediaSizeBytes to actual file length and mediaLastByte to length-1; issue grant with same size/type. Disable redirect following; 308 means incomplete upload, never HTTP redirect. Do not share session URL.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "{{mediaContentType}}"
              },
              {
                "key": "Content-Range",
                "value": "bytes 0-{{mediaLastByte}}/{{mediaSizeBytes}}"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "02b Query interrupted upload offset",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{mediaUploadUrl}}"
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Range",
                "value": "bytes */{{mediaSizeBytes}}"
              },
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "description": "Empty body. 308 Range reports last stored byte; absent Range means start at 0. Resume at last+1 with Content-Range bytes START-END/TOTAL. Nonfinal chunks must be multiples of 256 KiB. 200/201 means finished. Never attach backend JWT; do not log URLs."
          }

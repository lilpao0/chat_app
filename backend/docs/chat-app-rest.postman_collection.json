    {
      "name": "06 A searches for B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"B is found\", function () { pm.expect(body.items.some(item => String(item.id) === pm.collectionVariables.get(\"userBId\"))).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/users?q={{emailB}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "q",
              "value": "{{emailB}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "07 A opens direct chat with B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"New or existing chat\", function () { pm.expect([200, 201]).to.include(pm.response.code); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"conversationId\", body.conversation.id);",
              "pm.test(\"Counterpart is B\", function () { pm.expect(String(body.conversation.user.id)).to.eql(pm.collectionVariables.get(\"userBId\")); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/conversations/direct",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "direct"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{userBId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "08 A sends a message",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"messageId\", body.message.id);",
              "pm.test(\"Message belongs to A\", function () { pm.expect(String(body.message.sender_id)).to.eql(pm.collectionVariables.get(\"userAId\")); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Xin chao tu A\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "09 B lists chats (unread = 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const items = pm.response.json();",
              "const chat = items.find(item => String(item.id) === pm.collectionVariables.get(\"conversationId\"));",
              "pm.test(\"B has one unread message\", function () { pm.expect(chat).to.exist; pm.expect(chat.unread_count).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
